# ============================================================
# AVENGE — Edge Engine (.env for edge/)
# Copy to edge/.env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── Sensor interface: uncomment ONE ─────────────────────────
# SERIAL_INTERFACE=usb
# SERIAL_INTERFACE=rs485

# Docker only: the ONE serial device passed into the container,
# and the host dialout GID (run on the Pi: getent group dialout)
SERIAL_PORT=/dev/ttyACM0
DIALOUT_GID=20

# Native runs only (./edge-filter): USB device path (Arduino = ttyACM0, CH340 dongle = ttyUSB0)
USB_PORT=/dev/ttyACM0

# RS-485 device path (HAT or USB-to-RS485 dongle)
RS485_PORT=/dev/ttyUSB0
RS485_BAUD=230400

# ── Sensor tuning ───────────────────────────────────────────
SENSOR_ID=bearing_01
SENSOR_SAMPLE_RATE=1600

# ── Upstream (core stack) ────────────────────────────────────
# IP or hostname of the machine running core/compose.yaml
CENTRAL_HOST=127.0.0.1
MQTT_PORT=1883

# MQTT credentials: user "edge"; password = MQTT_EDGE_PASSWORD from core/.env
MQTT_USER=edge
MQTT_PASSWORD=changeme
