# ============================================================
# AVENGE — Edge Engine (.env for edge/)
# Copy to edge/.env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── Sensor interface: uncomment ONE ─────────────────────────
# SERIAL_INTERFACE=usb
# SERIAL_INTERFACE=rs485

# USB device path (Arduino = ttyACM0, CH340 dongle = ttyUSB0)
USB_PORT=/dev/ttyACM0

# RS-485 device path (HAT or USB-to-RS485 dongle)
RS485_PORT=/dev/ttyUSB0
RS485_BAUD=230400

# ── Sensor tuning ───────────────────────────────────────────
SENSOR_ID=bearing_01
SENSOR_SAMPLE_RATE=1600
FFT_WINDOW_SIZE=1024

# ── Upstream (core stack) ────────────────────────────────────
# IP or hostname of the machine running core/docker-compose.yml
CENTRAL_HOST=192.168.1.50
MQTT_PORT=1883
