# ============================================================
# AVENGE — Core Stack (.env for core/)
# Copy to core/.env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ── Exposed ports (change if something conflicts locally) ────
MQTT_PORT=1883
MQTT_WS_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
GRAFANA_PORT=3000
