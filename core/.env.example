# ============================================================
# AVENGE — Core Stack (.env for core/)
# Copy to core/.env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── ClickHouse ───────────────────────────────────────────────
# Admin account (manual work and schema setup only).
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
# Service accounts (no spaces; letters and digits are safest — Telegraf
# puts its password into a URL).
CLICKHOUSE_TELEGRAF_PASSWORD=changeme
CLICKHOUSE_GRAFANA_PASSWORD=changeme

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ── MQTT users (no spaces; letters and digits are safest) ────
# After editing, run: core/mosquitto/gen-passwd.sh
# MQTT_EDGE_PASSWORD must match MQTT_PASSWORD in edge/.env.
MQTT_EDGE_PASSWORD=changeme
MQTT_TELEGRAF_PASSWORD=changeme

# ── MQTT bind address ────────────────────────────────────────
# 127.0.0.1 = this machine only. For a real edge device, set this to
# the LAN IP of this machine (e.g. 192.168.1.50).
MQTT_BIND=127.0.0.1
