-	// Payload: client ID (length-prefixed string).
-	payload := encodeString(clientID)
+	// Payload: client ID, then username and password (length-prefixed strings).
+	payload := encodeString([]byte(c.cfg.ClientID))
+	if c.cfg.Username != "" {
